# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Photos sources (originaux lourds, non utilisés par le site).
# Les versions optimisées vivent dans public/images. Les noms de ces
# dossiers contiennent une espace finale, que Git et Windows gèrent mal.
/GALLERIE*/
/galerie*/

# Version publiée : tout ceci se fabrique, rien ne se versionne.
/public/_i/
/out/
/.next-export/
